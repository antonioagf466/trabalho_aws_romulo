const initSqlJs = require('sql.js');
const fs = require('fs');
const path = require('path');

const DB_PATH = path.resolve(__dirname, '../../tech_store.db');

let db;

function colunaExiste(tabela, coluna) {
  const resultado = db.exec(`PRAGMA table_info(${tabela});`);
  if (!resultado.length) return false;
  return resultado[0].values.some((linha) => linha[1] === coluna);
}

function adicionarColunaSeNaoExistir(tabela, coluna, definicao) {
  if (!colunaExiste(tabela, coluna)) {
    db.run(`ALTER TABLE ${tabela} ADD COLUMN ${coluna} ${definicao};`);
  }
}

async function inicializarBanco() {
  const SQL = await initSqlJs({
    locateFile: (file) =>
      path.resolve(__dirname, '../../node_modules/sql.js/dist', file)
  });

  if (fs.existsSync(DB_PATH)) {
    const arquivo = fs.readFileSync(DB_PATH);
    db = new SQL.Database(arquivo);
  } else {
    db = new SQL.Database();
  }

  db.run('PRAGMA foreign_keys = ON;');

  db.run(`
    CREATE TABLE IF NOT EXISTS categorias (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      nome TEXT NOT NULL UNIQUE
    );

    CREATE TABLE IF NOT EXISTS produtos (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      nome TEXT NOT NULL,
      descricao TEXT,
      marca TEXT,
      modelo TEXT,
      categoria_id INTEGER,
      sku TEXT UNIQUE,
      preco_compra REAL DEFAULT 0,
      preco_venda REAL NOT NULL DEFAULT 0,
      estoque_atual INTEGER NOT NULL DEFAULT 0,
      estoque_minimo INTEGER NOT NULL DEFAULT 0,
      imagem_url TEXT,
      ativo INTEGER NOT NULL DEFAULT 1,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (categoria_id) REFERENCES categorias(id)
    );

    CREATE TABLE IF NOT EXISTS admins (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      login TEXT NOT NULL UNIQUE,
      senha_hash TEXT NOT NULL,
      nivel_acesso TEXT NOT NULL DEFAULT 'ADMIN' CHECK (
        nivel_acesso IN ('ADMIN', 'SUPER_ADMIN')
      ),
      admin_ativo INTEGER NOT NULL DEFAULT 1 CHECK (admin_ativo IN (0, 1)),
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP
    );

    CREATE TABLE IF NOT EXISTS usuarios (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      nome TEXT NOT NULL,
      email TEXT NOT NULL UNIQUE,
      senha_hash TEXT NOT NULL,
      admin_id INTEGER UNIQUE,
      ativo INTEGER NOT NULL DEFAULT 1,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (admin_id) REFERENCES admins(id) ON DELETE SET NULL
    );

    CREATE TABLE IF NOT EXISTS movimentacoes_estoque (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      produto_id INTEGER NOT NULL,
      tipo TEXT NOT NULL CHECK (
        tipo IN ('ENTRADA', 'SAIDA', 'AJUSTE')
      ),
      quantidade INTEGER NOT NULL,
      saldo_anterior INTEGER NOT NULL,
      saldo_posterior INTEGER NOT NULL,
      observacao TEXT,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (produto_id) REFERENCES produtos(id)
    );

    CREATE TABLE IF NOT EXISTS vendas (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      produto_id INTEGER NOT NULL,
      usuario_id INTEGER,
      quantidade INTEGER NOT NULL CHECK (quantidade > 0),
      preco_unitario REAL NOT NULL,
      valor_total REAL GENERATED ALWAYS AS (quantidade * preco_unitario) STORED,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (produto_id) REFERENCES produtos(id),
      FOREIGN KEY (usuario_id) REFERENCES usuarios(id)
    );
  `);

  adicionarColunaSeNaoExistir('admins', 'login', 'TEXT');
  adicionarColunaSeNaoExistir('admins', 'senha_hash', 'TEXT');
  adicionarColunaSeNaoExistir(
    'admins',
    'admin_ativo',
    'INTEGER NOT NULL DEFAULT 1 CHECK (admin_ativo IN (0, 1))'
  );
  adicionarColunaSeNaoExistir('admins', 'updated_at', 'TEXT');

  db.run(`
    CREATE UNIQUE INDEX IF NOT EXISTS idx_admins_login ON admins(login);

    CREATE TRIGGER IF NOT EXISTS trg_vendas_validar_estoque
    BEFORE INSERT ON vendas
    BEGIN
      SELECT RAISE(ABORT, 'Produto não encontrado ou inativo.')
      WHERE NOT EXISTS (
        SELECT 1 FROM produtos
        WHERE id = NEW.produto_id AND ativo = 1
      );

      SELECT RAISE(ABORT, 'Estoque insuficiente para realizar a venda.')
      WHERE (
        SELECT estoque_atual FROM produtos WHERE id = NEW.produto_id
      ) < NEW.quantidade;
    END;

    CREATE TRIGGER IF NOT EXISTS trg_vendas_baixar_estoque
    AFTER INSERT ON vendas
    BEGIN
      INSERT INTO movimentacoes_estoque (
        produto_id, tipo, quantidade, saldo_anterior, saldo_posterior, observacao
      )
      SELECT
        NEW.produto_id,
        'SAIDA',
        NEW.quantidade,
        estoque_atual,
        estoque_atual - NEW.quantidade,
        'Venda #' || NEW.id
      FROM produtos
      WHERE id = NEW.produto_id;

      UPDATE produtos
      SET estoque_atual = estoque_atual - NEW.quantidade,
          updated_at = CURRENT_TIMESTAMP
      WHERE id = NEW.produto_id;
    END;
  `);

  const categorias = [
    'Computadores',
    'Smartphones',
    'Áudio',
    'Periféricos'
  ];

  for (const nome of categorias) {
    db.run(
      'INSERT OR IGNORE INTO categorias (nome) VALUES (?)',
      [nome]
    );
  }

  salvarBanco();

  console.log('Banco de dados Tech Store inicializado!');
}

function getDb() {
  if (!db) {
    throw new Error('O banco de dados ainda não foi inicializado.');
  }

  return db;
}

function salvarBanco() {
  if (!db) return;

  const dados = db.export();
  fs.writeFileSync(DB_PATH, Buffer.from(dados));
}

module.exports = {
  inicializarBanco,
  getDb,
  salvarBanco
};